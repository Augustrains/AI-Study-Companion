# OpenCode Go 的 OpenAI-compatible 模型
STUDY_COMPANION_LLM_API_KEY=your_opencode_api_key
STUDY_COMPANION_LLM_MODEL=deepseek-v4-flash
STUDY_COMPANION_LLM_BASE_URL=https://opencode.ai/zen/go/v1
STUDY_COMPANION_LLM_TIMEOUT=120

# 用户画像模块的 MySQL 连接（不要将真实密码提交到 Git）
STUDY_COMPANION_DB_HOST=127.0.0.1
STUDY_COMPANION_DB_PORT=3306
STUDY_COMPANION_DB_NAME=ai_study_companion
STUDY_COMPANION_DB_USER=dbadmin
STUDY_COMPANION_DB_PASSWORD=your_database_password

# 每日任务资料搜索 Agent 的 Tavily MCP 密钥
TAVILY_API_KEY=tvly_your_tavily_api_key
