# OpenCode Go 的 OpenAI-compatible 模型
STUDY_COMPANION_LLM_API_KEY=your_opencode_api_key
STUDY_COMPANION_LLM_MODEL=deepseek-v4-flash
STUDY_COMPANION_LLM_BASE_URL=https://opencode.ai/zen/go/v1
STUDY_COMPANION_LLM_TIMEOUT=120

# 业务数据：本地开发默认 SQLite；部署时替换为 PostgreSQL URL。
STUDY_COMPANION_DATABASE_URL=sqlite+pysqlite:///./data/study_companion.sqlite3

# LangGraph checkpoint 独立存储，避免与业务库争用 SQLite 写锁。
STUDY_COMPANION_CHECKPOINT_BACKEND=sqlite
STUDY_COMPANION_CHECKPOINT_URL=./data/langgraph_checkpoints.sqlite3
