#!/bin/bash
# 双击这个文件即可启动「自适应伴学智能体」（后端 + 新版前端）
# 自动定位到脚本所在目录，不依赖任何绝对路径，换台电脑也能用。
cd "$(dirname "$0")" || {
  echo "无法定位项目目录。"
  read -n 1 -s -r -p "按任意键关闭窗口..."
  exit 1
}

echo "正在启动自适应伴学智能体……"
echo "启动完成后，浏览器打开 http://127.0.0.1:5173 即可使用。"
echo "关闭这个窗口，或按 Ctrl+C，即可停止服务。"
echo ""

python3.11 main.py

echo ""
read -n 1 -s -r -p "服务已停止，按任意键关闭窗口..."
